{
  "name": "@salve-software/nodeless",
  "version": "0.0.0-development",
  "type": "module",
  "description": "npm install and a React build, without Node. The same code in a server and in the browser: no shell, no filesystem, no VM.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salve-Software/nodeless.git"
  },
  "homepage": "https://github.com/Salve-Software/nodeless#readme",
  "bugs": {
    "url": "https://github.com/Salve-Software/nodeless/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "bundler",
    "esbuild",
    "esbuild-wasm",
    "browser",
    "browser-build",
    "npm-install",
    "package-manager",
    "virtual-filesystem",
    "vfs",
    "playground",
    "live-preview",
    "react",
    "typescript"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:fast": "tsgo --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx example/node/build.ts",
    "example:install": "tsx example/node/install.ts",
    "example:tailwind": "tsx example/node/tailwind.ts",
    "playground": "npm run build && tsx example/node/playground.ts",
    "example:browser:test": "npm run build && tsx example/node/browser.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "esbuild-wasm": "^0.25.10",
    "fflate": "^0.8.3",
    "resolve.exports": "^2.0.3",
    "semver": "^7.8.5"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.18.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.8.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,yml,yaml}": "prettier --write"
  }
}
